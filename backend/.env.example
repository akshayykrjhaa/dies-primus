# Copy to backend/.env and fill in. The server starts without these, but
# /api/analyze needs a model key to produce real descriptions.

# --- Which model writes the tour --------------------------------------
# "groq", "anthropic", or "gemini" (default when a Gemini key is present).
LLM_PROVIDER=gemini

# Groq: free tier works, see the rate-limit notes in the README.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Groq meters tokens per model, so the file batches fan out across these two
# to roughly double the throughput available on the free tier.
GROQ_FILE_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Free tier: 8000 tokens/minute per model. Raise on a paid tier.
GROQ_TPM=8000
GROQ_MAX_OUTPUT=1800

# Anthropic (alternative provider)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Google Gemini (recommended free provider — 1M tokens/min free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- GitHub -------------------------------------------------------------
# Optional but recommended: raises the limit from 60 to 5000 requests/hour
# and lets you map private repos you can read.
GITHUB_TOKEN=

# --- GitHub OAuth ("Connect GitHub" login) -------------------------------
# Create an OAuth App at https://github.com/settings/developers.
# Authorization callback URL must match GITHUB_OAUTH_REDIRECT_URI exactly.
# When set, a signed-in user's own token is used for their analyses instead
# of GITHUB_TOKEN above — their own rate limit, their own private repos.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Dev default goes through the Vite proxy (localhost:5173) so the session
# cookie lands on the same origin the frontend calls /api on. For a
# single-origin build (start.ps1 -BuildOnly) point this at the API port,
# e.g. http://127.0.0.1:8010/api/auth/github/callback
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/github/callback
# "repo" is needed to read private repos; use "read:user" for public-only.
GITHUB_OAUTH_SCOPES=read:user repo
FRONTEND_URL=http://localhost:5173
# true once the app is served over HTTPS, so session cookies get Secure.
SESSION_COOKIE_SECURE=false

# --- Optional tuning ----------------------------------------------------
# Left blank, these pick provider-aware defaults (Groq gets smaller, more
# compact batches because of its per-minute token budget).
MAX_BUILDINGS=320
MAX_LLM_FILES=
LLM_BATCH_SIZE=
LLM_CONCURRENCY=
FILE_CHAR_BUDGET=
FILE_EFFORT=
PROJECT_EFFORT=

# Send SDK traffic somewhere else (a gateway, or tests/mock_anthropic.py).
ANTHROPIC_BASE_URL=
GROQ_BASE_URL=
